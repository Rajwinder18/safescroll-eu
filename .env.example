# Safe Scroll environment template
# Copy to apps/web/.env.local (or repo root .env.local) when credentials are available.
# The app runs fully in development/demo mode without these values.

# Web (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_MOCK=true

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_USE_MOCK=true

# Never place service-role keys in web or mobile environment variables.
