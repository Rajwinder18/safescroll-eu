{
  "name": "safescroll",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @safescroll/web",
    "dev:web": "npm run dev -w @safescroll/web",
    "dev:mobile": "npm run start -w @safescroll/mobile",
    "build": "npm run build -w @safescroll/web",
    "build:web": "npm run build -w @safescroll/web",
    "preview": "npm run preview -w @safescroll/web",
    "test": "npm run test -w @safescroll/wellbeing-engine --if-present && npm run test -w @safescroll/web --if-present",
    "typecheck": "npm run typecheck -w @safescroll/web --if-present"
  },
  "engines": {
    "node": ">=18"
  }
}
